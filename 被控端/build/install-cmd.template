@echo off
setlocal EnableExtensions
rem ============================================================
rem  DSH Fleet Node installer
rem  install.cmd            -> install to %ProgramFiles%\DSH Fleet
rem  install.cmd /S         -> silent
rem  install.cmd "D:\path"  -> custom directory
rem
rem  Keep this file ASCII-only (codepage issues on Chinese Windows).
rem
rem  Two things that MUST stay:
rem   1) the empty-argument branch: %* is EMPTY on double-click, and
rem      "Start-Process -ArgumentList ''" throws -> nothing happens.
rem   2) -PassThru + WaitForExit: the self-extractor deletes its temp
rem      folder as soon as THIS script exits, so it must wait for the
rem      elevated copy to finish, or the payload disappears mid-install.
rem ============================================================

set "TARGET=%ProgramFiles%\DSH Fleet"
if not "%~1"=="" if /i not "%~1"=="/S" set "TARGET=%~1"
set "LABEL=%COMPUTERNAME%"

net session >nul 2>&1
if errorlevel 1 (
  echo [i] Administrator rights required - asking Windows for elevation...
  if "%~1"=="" (
    powershell -NoProfile -ExecutionPolicy Bypass -Command "$p = Start-Process -FilePath '%~f0' -Verb RunAs -PassThru; if ($p) { $p.WaitForExit() }"
  ) else (
    powershell -NoProfile -ExecutionPolicy Bypass -Command "$p = Start-Process -FilePath '%~f0' -ArgumentList '%*' -Verb RunAs -PassThru; if ($p) { $p.WaitForExit() }"
  )
  if errorlevel 1 (
    echo.
    echo [x] Elevation was cancelled or blocked.
    echo     Right-click install.cmd and choose "Run as administrator".
    pause
  )
  exit /b
)

echo.
echo Target directory: %TARGET%
if not exist "%TARGET%" mkdir "%TARGET%" >nul 2>&1
if not exist "%TARGET%" (
  echo [x] Cannot create target directory. Check permissions.
  pause
  exit /b 1
)

echo Extracting payload...
tar.exe -xf "%~dp0payload.zip" -C "%TARGET%"
if errorlevel 1 (
  echo [x] Extraction failed.
  pause
  exit /b 1
)

echo Registering agent and scheduled tasks...
powershell -NoProfile -ExecutionPolicy Bypass -File "%TARGET%\fleet\install.ps1" -Label "%LABEL%"
if errorlevel 1 (
  echo [x] install.ps1 failed. See %TARGET%\fleet\logs\agent.log
  pause
  exit /b 1
)

echo.
echo [ok] Installed. The node should show up in the control panel within seconds.
echo      Log: %TARGET%\fleet\logs\agent.log
if /i not "%~1"=="/S" pause
